# Copy to .env.gigachat; enable explicitly with --llm-symbolic-search.
MONOTONE_CALIBRATE_LLM_ENABLED=false
MONOTONE_CALIBRATE_LLM_PROVIDER=gigachat
# Set an exact model identifier available to your GigaChat account.
MONOTONE_CALIBRATE_LLM_MODEL=GigaChat-2
# Authorization key, not an OpenRouter key; OAuth token refresh is handled by SDK.
MONOTONE_CALIBRATE_LLM_GIGACHAT_CREDENTIALS=your-authorization-key
# Alternatively leave CREDENTIALS empty and supply a short-lived access token.
MONOTONE_CALIBRATE_LLM_GIGACHAT_ACCESS_TOKEN=
MONOTONE_CALIBRATE_LLM_GIGACHAT_SCOPE=GIGACHAT_API_PERS
MONOTONE_CALIBRATE_LLM_GIGACHAT_BASE_URL=https://api.giga.chat/v1
MONOTONE_CALIBRATE_LLM_GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
MONOTONE_CALIBRATE_LLM_GIGACHAT_VERIFY_SSL_CERTS=true
# Optional path to a trusted PEM CA bundle for your environment.
MONOTONE_CALIBRATE_LLM_GIGACHAT_CA_BUNDLE_FILE=
MONOTONE_CALIBRATE_LLM_TIMEOUT_SECONDS=120
MONOTONE_CALIBRATE_LLM_MAX_RETRIES=1
MONOTONE_CALIBRATE_LLM_SEARCH_ITERATIONS=4
MONOTONE_CALIBRATE_LLM_MAX_OUTPUT_TOKENS=4096
# Set only for a model that supports reasoning_effort; otherwise leave blank.
MONOTONE_CALIBRATE_LLM_REASONING_EFFORT=
MONOTONE_CALIBRATE_LLM_ALLOW_INSECURE_HTTP=false
