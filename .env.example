# The mathematical pipeline is fully offline unless this is explicitly true.
MONOTONE_CALIBRATE_LLM_ENABLED=false

# OpenAI-compatible endpoint settings used only when the advisor is enabled.
MONOTONE_CALIBRATE_LLM_MODEL=tencent/hy3:free
MONOTONE_CALIBRATE_LLM_BASE_URL=https://openrouter.ai/api/v1
# Never commit a real token. Copy this file to `.env` and set the value locally.
MONOTONE_CALIBRATE_LLM_ACCESS_TOKEN=your-access-token
MONOTONE_CALIBRATE_LLM_TIMEOUT_SECONDS=20
MONOTONE_CALIBRATE_LLM_MAX_RETRIES=3
MONOTONE_CALIBRATE_LLM_ALLOW_INSECURE_HTTP=false
