    "reviewed_evidence_digest": {"$ref": "#/$defs/hash"},
    "reviewers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statistical_model", "security_operations"],
      "properties": {
        "statistical_model": {"$ref": "#/$defs/reviewer"},
        "security_operations": {"$ref": "#/$defs/reviewer"}
      }
    },
    "independence_attestation": {"const": "distinct-external-ed25519-trust-roots-on-one-evidence-digest-v1"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?:/[A-Za-z0-9][A-Za-z0-9._-]{0,127})*$", "maxLength": 512},
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safe_path"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "priority", "status", "design_gate_sha256", "evidence_path", "evidence_sha256", "declared_executor"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"},
        "priority": {"enum": ["P0", "P1"]},
        "status": {"const": "PASS"},
        "design_gate_sha256": {"$ref": "#/$defs/hash"},
        "evidence_path": {"$ref": "#/$defs/safe_path"},
        "evidence_sha256": {"$ref": "#/$defs/hash"},
        "declared_executor": {"type": "string", "minLength": 1}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "verdict", "evidence_digest", "release_snapshot_digest", "verifier_runtime_lock_sha256", "public_key_sha256", "review_evidence"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "verdict": {"const": "GO"},
        "evidence_digest": {"$ref": "#/$defs/hash"},
        "release_snapshot_digest": {"$ref": "#/$defs/hash"},
        "verifier_runtime_lock_sha256": {"$ref": "#/$defs/hash"},
        "public_key_sha256": {"$ref": "#/$defs/hash"},
        "review_evidence": {"$ref": "#/$defs/file_ref"}
      }
    }
  },
  "$comment": "All JSON is decoded by strict-json-v1. The mandatory verifier requires two caller-selected out-of-band --reviewer-public-key AXIS=PATH arguments, validates distinct Ed25519 keys and signatures, exact source-tree inventory, semantic policy/registry schemas, design gate/fixture/oracle/test bindings and bounded file hashes. Results-declared keys and self-declared reviewer IDs never select a trust root. Custodian independence and hardlink identity remain caller trust responsibilities. The frozen design manifest remains NOT_RUN forever."
}
