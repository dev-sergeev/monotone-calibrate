        {"allOf": [{"$ref": "#/$defs/gate_result"}, {"properties": {"gate_id": {"const": "BENCHMARK-019"}, "priority": {"const": "P1"}, "design_gate_sha256": {"const": "61704200c99b0c050c276b6cb1c4de8f93ab9311dc110b5245ec2b4113885f0d"}, "evidence_path": {"const": "evidence/acceptance/BENCHMARK-019.json"}, "declared_executor": {"const": "python tools/benchmark.py --full --evidence evidence/acceptance/BENCHMARK-019.json"}}}]},
        {"allOf": [{"$ref": "#/$defs/gate_result"}, {"properties": {"gate_id": {"const": "LLM-ADVISOR-020"}, "priority": {"const": "P1"}, "design_gate_sha256": {"const": "a6c90d814942fffb4bf45501b09840f9e05536587d15f43b0e42d7c3000534b5"}, "evidence_path": {"const": "evidence/acceptance/LLM-ADVISOR-020.json"}, "declared_executor": {"const": "pytest tests/acceptance/test_llm_advisor.py tests/security/test_llm_secrets_network.py"}}}]}
