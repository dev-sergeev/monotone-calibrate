        {"allOf": [{"$ref": "#/$defs/gate_result"}, {"properties": {"gate_id": {"const": "CHECKPOINT-009"}, "priority": {"const": "P0"}, "design_gate_sha256": {"const": "a18fbe026de26553bb8b19d2c4316e5f1e0df458e9a52a3cea9768b6a2d1ed0b"}, "evidence_path": {"const": "evidence/acceptance/CHECKPOINT-009.json"}, "declared_executor": {"const": "pytest tests/acceptance/test_checkpoint_resume.py"}}}]},
        {"allOf": [{"$ref": "#/$defs/gate_result"}, {"properties": {"gate_id": {"const": "FAILURE-EXIT-010"}, "priority": {"const": "P0"}, "design_gate_sha256": {"const": "4c640a0ccfa4b63546d6a35c1866b949c5a2592842e272b6005ced31bddff91c"}, "evidence_path": {"const": "evidence/acceptance/FAILURE-EXIT-010.json"}, "declared_executor": {"const": "pytest tests/acceptance/test_exit_matrix.py"}}}]},
