        {"allOf": [{"$ref": "#/$defs/gate_result"}, {"properties": {"gate_id": {"const": "REPORT-SEC-013"}, "priority": {"const": "P0"}, "design_gate_sha256": {"const": "32c8fd5eb6d027791f38850c93c5bc1b8722db1591a36e062723eaf44a160a6b"}, "evidence_path": {"const": "evidence/acceptance/REPORT-SEC-013.json"}, "declared_executor": {"const": "static safety audit plus file:// browser/network observation on both browser targets"}}}]},
        {"allOf": [{"$ref": "#/$defs/gate_result"}, {"properties": {"gate_id": {"const": "PRIVACY-014"}, "priority": {"const": "P0"}, "design_gate_sha256": {"const": "b3e649da1396eda24ba3919030e43275da75849bd6589ce281130c3667fd2847"}, "evidence_path": {"const": "evidence/acceptance/PRIVACY-014.json"}, "declared_executor": {"const": "pytest tests/security/test_sensitive_boundaries.py"}}}]},
        {"allOf": [{"$ref": "#/$defs/gate_result"}, {"properties": {"gate_id": {"const": "IDENTITY-015"}, "priority": {"const": "P1"}, "design_gate_sha256": {"const": "d0be9fe28041c8bc3cb144577db5c2203341f02576079abf03ef8908241affa7"}, "evidence_path": {"const": "evidence/acceptance/IDENTITY-015.json"}, "declared_executor": {"const": "pytest tests/contracts/test_identity_goldens.py"}}}]},
