{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:monotone-calibrate:schema:acceptance-environment:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment_id", "identity_payload", "raw_probe"],
  "properties": {
    "schema_version": {"const": "acceptance-environment-v1"},
    "environment_id": {"$ref": "#/$defs/hash"},
    "identity_payload": {"$ref": "#/$defs/identity_payload"},
    "raw_probe": {"$ref": "#/$defs/file_ref"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?:/[A-Za-z0-9][A-Za-z0-9._-]{0,127})*$", "maxLength": 512},
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}
    },
    "identity_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "os_name", "distribution", "distribution_version", "architecture", "python_implementation", "python_version", "python_build", "python_compiler", "python_executable_sha256", "source_manifest_sha256", "source_archive_sha256", "dependency_lock_sha256", "policy_sha256", "registry_sha256", "packages_sha256", "solver_backend", "cpu_numerical_features", "blas_lapack", "thread_policy", "floating_point_mode"],
      "properties": {
        "platform": {"type": "string"},
        "os_name": {"type": "string"},
        "distribution": {"type": "string"},
        "distribution_version": {"type": "string"},
        "architecture": {"type": "string"},
        "python_implementation": {"const": "CPython"},
        "python_version": {"type": "string", "pattern": "^3\\.12(?:\\.[0-9]+)?$"},
        "python_build": {"type": "string", "minLength": 1, "maxLength": 512},
        "python_compiler": {"type": "string", "minLength": 1, "maxLength": 512},
        "python_executable_sha256": {"$ref": "#/$defs/hash"},
        "source_manifest_sha256": {"$ref": "#/$defs/hash"},
        "source_archive_sha256": {"$ref": "#/$defs/hash"},
        "dependency_lock_sha256": {"$ref": "#/$defs/hash"},
        "policy_sha256": {"$ref": "#/$defs/hash"},
        "registry_sha256": {"$ref": "#/$defs/hash"},
        "packages_sha256": {"$ref": "#/$defs/hash"},
        "solver_backend": {"type": "object"},
        "cpu_numerical_features": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "blas_lapack": {"type": "object"},
        "thread_policy": {"type": "object"},
        "floating_point_mode": {"type": "object"}
      },
      "oneOf": [
        {
          "properties": {
            "platform": {"const": "macOS 14 or newer, arm64, CPython 3.12"},
            "os_name": {"const": "Darwin"},
            "distribution": {"const": "macOS"},
            "distribution_version": {"pattern": "^(1[4-9]|[2-9][0-9])(?:\\.[0-9]+){0,2}$"},
            "architecture": {"const": "arm64"}
          }
        },
        {
          "properties": {
            "platform": {"const": "Ubuntu 24.04 LTS, x86_64, CPython 3.12"},
            "os_name": {"const": "Linux"},
            "distribution": {"const": "Ubuntu"},
            "distribution_version": {"pattern": "^24\\.04(?:\\.[0-9]+)?$"},
            "architecture": {"const": "x86_64"}
          }
        }
      ]
    }
  }
}
