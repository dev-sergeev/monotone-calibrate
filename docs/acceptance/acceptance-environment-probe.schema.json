{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:monotone-calibrate:schema:acceptance-environment-probe:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "platform",
    "os_name",
    "distribution",
    "distribution_version",
    "architecture",
    "python_implementation",
    "python_version",
    "python_build",
    "python_compiler",
    "python_executable_sha256",
    "packages",
    "solver_backend",
    "cpu_numerical_features",
    "blas_lapack",
    "thread_policy",
    "floating_point_mode"
  ],
  "properties": {
    "schema_version": {"const": "acceptance-environment-probe-v1"},
    "platform": {"type": "string", "minLength": 1},
    "os_name": {"type": "string", "minLength": 1},
    "distribution": {"type": "string", "minLength": 1},
    "distribution_version": {"type": "string", "minLength": 1},
    "architecture": {"type": "string", "minLength": 1},
    "python_implementation": {"const": "CPython"},
    "python_version": {"type": "string", "pattern": "^3\\.12(?:\\.[0-9]+)?$"},
    "python_build": {"type": "string", "minLength": 1, "maxLength": 512},
    "python_compiler": {"type": "string", "minLength": 1, "maxLength": 512},
    "python_executable_sha256": {"$ref": "#/$defs/hash"},
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 128},
          "version": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "solver_backend": {"$ref": "#/$defs/solver_backend"},
    "cpu_numerical_features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "blas_lapack": {"$ref": "#/$defs/blas_lapack"},
    "thread_policy": {"$ref": "#/$defs/thread_policy"},
    "floating_point_mode": {"$ref": "#/$defs/floating_point_mode"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "solver_backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "optimizer", "method"],
      "properties": {
        "package": {"const": "scipy"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "optimizer": {"const": "scipy.optimize.least_squares"},
        "method": {"const": "trf"}
      }
    },
    "blas_lapack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blas_vendor", "blas_version", "lapack_vendor", "lapack_version"],
      "properties": {
        "blas_vendor": {"type": "string", "minLength": 1, "maxLength": 256},
        "blas_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "lapack_vendor": {"type": "string", "minLength": 1, "maxLength": 256},
        "lapack_version": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "thread_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "omp_num_threads", "openblas_num_threads", "mkl_num_threads", "veclib_maximum_threads", "numexpr_num_threads", "effective_max_threads"],
      "properties": {
        "policy_id": {"const": "single-thread-numerics-v1"},
        "omp_num_threads": {"const": 1},
        "openblas_num_threads": {"const": 1},
        "mkl_num_threads": {"const": 1},
        "veclib_maximum_threads": {"const": 1},
        "numexpr_num_threads": {"const": 1},
        "effective_max_threads": {"const": 1}
      }
    },
    "floating_point_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rounding_mode", "flush_to_zero", "denormals_are_zero", "fma_policy"],
      "properties": {
        "rounding_mode": {"const": "nearest"},
        "flush_to_zero": {"type": "boolean"},
        "denormals_are_zero": {"type": "boolean"},
        "fma_policy": {"enum": ["contract_off", "contract_on", "runtime"]}
      }
    }
  }
}
