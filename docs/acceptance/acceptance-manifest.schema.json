{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:monotone-calibrate:acceptance-manifest:v1",
  "title": "Monotone calibration acceptance manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "manifest_version",
    "acceptance_id",
    "decision_boundary",
    "parser_policy",
    "identity_policy",
    "numeric_policy",
    "simulation_policy",
    "work_policy",
    "source_inventory_policy",
    "source_snapshot_policy",
    "gate_execution_policy",
    "release_anchor_policy",
    "reviewer_authentication_policy",
    "llm_policy",
    "semantic_validation_policy",
    "verifier_runtime_policy",
    "verifier_policy",
    "platform_policy",
    "bundle_contract",
    "fixture_sets",
    "gates",
    "nonclaims"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "manifest_version": {"const": "acceptance-manifest-v1"},
    "acceptance_id": {"const": "monotone-calibrate-acceptance-v1"},
    "decision_boundary": {"$ref": "#/$defs/object"},
    "parser_policy": {"$ref": "#/$defs/object"},
    "identity_policy": {"$ref": "#/$defs/object"},
    "numeric_policy": {"$ref": "#/$defs/object"},
    "simulation_policy": {"$ref": "#/$defs/object"},
    "work_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "path", "sha256"],
      "properties": {
        "policy_id": {"const": "work-policy-v1"},
        "path": {"const": "docs/acceptance/work-policy-v1.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source_inventory_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "path", "sha256", "schema_path", "schema_sha256"],
      "properties": {
        "policy_id": {"const": "monotone-calibrate-source-inventory-v1"},
        "path": {"const": "docs/acceptance/source-inventory-policy-v1.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_path": {"const": "docs/acceptance/source-inventory-policy.schema.json"},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source_snapshot_policy": {"$ref": "#/$defs/object"},
    "gate_execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "path", "sha256", "schema_path", "schema_sha256"],
      "properties": {
        "policy_id": {"const": "monotone-calibrate-gate-execution-v1"},
        "path": {"const": "docs/acceptance/gate-execution-policy-v1.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_path": {"const": "docs/acceptance/gate-execution-policy.schema.json"},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "release_anchor_policy": {"$ref": "#/$defs/object"},
    "reviewer_authentication_policy": {"$ref": "#/$defs/object"},
    "llm_policy": {"$ref": "#/$defs/object"},
    "semantic_validation_policy": {"$ref": "#/$defs/object"},
    "verifier_runtime_policy": {"$ref": "#/$defs/object"},
    "verifier_policy": {"$ref": "#/$defs/object"},
    "platform_policy": {"$ref": "#/$defs/object"},
    "bundle_contract": {"$ref": "#/$defs/object"},
    "fixture_sets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fixture"}
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    },
    "nonclaims": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "object": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "definition", "oracle", "stage", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]+$"},
        "kind": {"enum": ["synthetic", "metamorphic", "empirical", "security", "golden", "process"]},
        "definition": {"type": "string", "minLength": 1},
        "files": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "sha256": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "seeds": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "oracle": {"type": "string", "minLength": 1},
        "stage": {"enum": ["wayfinder", "implementation"]},
        "status": {"enum": ["PASS", "NOT_RUN"]}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "requirement_sources",
        "fixture_ids",
        "command_or_executor",
        "oracle",
        "evidence_path",
        "stage",
        "status"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"},
        "priority": {"enum": ["P0", "P1"]},
        "requirement_sources": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "fixture_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "command_or_executor": {"type": "string", "minLength": 1},
        "oracle": {"type": "string", "minLength": 1},
        "tolerance_policy": {"type": ["string", "null"]},
        "evidence_path": {"type": "string", "minLength": 1},
        "stage": {"const": "implementation"},
        "status": {"const": "NOT_RUN"}
      }
    }
  }
}
