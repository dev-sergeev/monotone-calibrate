{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:monotone-calibrate:schema:acceptance-oracle-result:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_id", "oracle_id", "oracle_text_sha256", "fixture_ledger_sha256", "tolerance_policy", "status", "observations"],
  "properties": {
    "schema_version": {"const": "acceptance-oracle-result-v1"},
    "gate_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"},
    "oracle_id": {"type": "string", "minLength": 1},
    "oracle_text_sha256": {"$ref": "#/$defs/hash"},
    "fixture_ledger_sha256": {"$ref": "#/$defs/hash"},
    "tolerance_policy": {"type": ["string", "null"]},
    "status": {"const": "PASS"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "status", "actual", "source_artifact"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "status": {"const": "PASS"},
          "actual": {"type": "string", "minLength": 1},
          "source_artifact": {"$ref": "#/$defs/file_ref"}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?:/[A-Za-z0-9][A-Za-z0-9._-]{0,127})*$", "maxLength": 512},
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}
    }
  }
}
