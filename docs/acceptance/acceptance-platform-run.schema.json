{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:monotone-calibrate:schema:acceptance-platform-run:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_id", "platform", "environment_id", "declared_executor", "execution_context", "argv", "source_targets", "test_results", "exit_status"],
  "properties": {
    "schema_version": {"const": "acceptance-platform-run-v1"},
    "gate_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"},
    "platform": {"type": "string", "minLength": 1},
    "environment_id": {"$ref": "#/$defs/hash"},
    "declared_executor": {"type": "string", "minLength": 1},
    "execution_context": {"type": "object"},
    "argv": {"type": "array", "minItems": 3, "maxItems": 64, "items": {"type": "string", "minLength": 1}},
    "source_targets": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "test_results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "status"],
        "properties": {
          "test_id": {"type": "string", "minLength": 1},
          "status": {"const": "PASS"}
        }
      }
    },
    "exit_status": {"const": 0}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
