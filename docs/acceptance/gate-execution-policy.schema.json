{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:monotone-calibrate:schema:gate-execution-policy:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "required_platforms", "execution_context", "gates"],
  "properties": {
    "schema_version": {"const": "gate-execution-policy-v1"},
    "policy_id": {"const": "monotone-calibrate-gate-execution-v1"},
    "required_platforms": {
      "const": [
        "macOS 14 or newer, arm64, CPython 3.12",
        "Ubuntu 24.04 LTS, x86_64, CPython 3.12"
      ]
    },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["working_directory", "source_materialization", "runner", "environment"],
      "properties": {
        "working_directory": {"const": "."},
        "source_materialization": {"const": "canonical-source-zip-v1"},
        "runner": {"const": ".venv/bin/python"},
        "environment": {
          "const": {
            "LC_ALL": "C",
            "MKL_NUM_THREADS": "1",
            "NUMEXPR_NUM_THREADS": "1",
            "OMP_NUM_THREADS": "1",
            "OPENBLAS_NUM_THREADS": "1",
            "PYTHONHASHSEED": "0",
            "PYTHONUTF8": "1",
            "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1",
            "VECLIB_MAXIMUM_THREADS": "1"
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/gate"}
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "executor_kind", "argv", "source_targets", "test_ids", "tolerance_policy"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"},
        "executor_kind": {"enum": ["pytest", "python_workflow"]},
        "argv": {
          "type": "array",
          "minItems": 3,
          "maxItems": 64,
          "prefixItems": [{"const": ".venv/bin/python"}, {"const": "-I"}],
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "source_targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(tests|tools)/[A-Za-z0-9_./-]+\\.py$", "maxLength": 512}
        },
        "test_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "tolerance_policy": {"type": ["string", "null"]}
      }
    }
  }
}
