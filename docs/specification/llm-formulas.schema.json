{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM formula proposals v1",
  "description": "Runtime additionally checks degree <=3, nodes <=31, depth <=8, parameters <=10, nonlinear nesting and structural novelty.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypotheses"
  ],
  "properties": {
    "schema_version": {
      "const": "llm-formulas-v1"
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "branches"
        ],
        "properties": {
          "branches": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/expression"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "expression": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "t"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "arg"
          ],
          "properties": {
            "op": {
              "enum": [
                "scale",
                "square",
                "cube",
                "expm1",
                "log1p",
                "sqrt1p",
                "saturate"
              ]
            },
            "arg": {
              "$ref": "#/$defs/expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "add",
                "mul"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        }
      ]
    }
  }
}
